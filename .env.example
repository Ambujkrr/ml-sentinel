APP_NAME=ML Sentinel
APP_ENV=development

POSTGRES_DB=ml_sentinel
POSTGRES_USER=ml_sentinel
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql+psycopg://ml_sentinel:replace-with-a-local-development-password@db:5432/ml_sentinel

# Optional: override the relative upload directory in a deployed service.
UPLOAD_DIR=data/uploads
